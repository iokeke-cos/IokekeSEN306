package financial;

public class FinancialManager {

    // Named Constants replacing the magic numbers found in Screenshot 2026-06-02 191954.png
    private static final int MAX_RECORDS = 100;
    private static final int MONTHS_IN_YEAR = 12;
    private static final double REVENUE_CALCULATION_MULTIPLIER = 4.0;
    
    private static final int EXPENSE_TYPE_STANDARD = 1;
    private static final int EXPENSE_TYPE_CORPORATE = 2;
    private static final int EXPENSE_TYPE_SPECIAL = 3;

    // Placeholders for variables that were treated globally/externally in the slide code
    private static double[][] corpExpense; 
    private static double[] profit = new double[MONTHS_IN_YEAR];
    private static final int SUCCESS = 1;

    /**
     * Refactored main routine.
     * 
     * Requirements Met:
     * - Clear name using verb + object structure.
     * - Removed unused parameters: screenX, screenY.
     * - Extracted additional pass-by-value parameters that were being overwritten/unused (newColor, prevColor, status).
     */
    public static void processQuarterlyFinancials(InputRecord inputRec, int crntQtr, EmpRecord empRec, double ytdRevenue, int expenseType) {
        
        // Requirement: Add a zero-check for quarter (throw an exception if 0)
        if (crntQtr == 0) {
            throw new IllegalArgumentException("Current quarter (crntQtr) cannot be zero to avoid division by zero.");
        }

        // Requirement: Split into at least 4 cohesive routines (see definitions below)
        initializeInputRecord(inputRec, crntQtr);
        
        updateCorpDatabase(empRec);
        
        double estimRevenue = calculateEstimatedRevenue(ytdRevenue, crntQtr);
        
        calculateMonthlyProfits(inputRec, expenseType);
        
        // Note: 'status = SUCCESS' and 'newColor = prevColor' were dropped as they were local 
        // side-effects that did not affect any logic or return states in the original function.
    }

    /**
     * Routine 1: Cohesive task to initialize array data.
     */
    private static void initializeInputRecord(InputRecord inputRec, int crntQtr) {
        for (int i = 0; i < MAX_RECORDS; i++) {
            inputRec.revenue[i] = 0;
            inputRec.expense[i] = corpExpense[crntQtr][i];
        }
    }

    /**
     * Routine 2: Placeholder for corporate database operations.
     */
    private static void updateCorpDatabase(EmpRecord empRec) {
        // Business logic for updating the corporate database
    }

    /**
     * Routine 3: Pure calculation routine for annual revenue projection.
     */
    private static double calculateEstimatedRevenue(double ytdRevenue, int crntQtr) {
        return ytdRevenue * REVENUE_CALCULATION_MULTIPLIER / crntQtr;
    }

    /**
     * Routine 4: Cohesive task to calculate profits safely based on categorization.
     * 
     * Fixes Met:
     * - Fixed BUG: 'revenue' undefined (properly extracted via inputRec.revenue[i]).
     * - Fixed BUG: Missing loops for expense types 2 and 3 are now fully realized.
     */
    private static void calculateMonthlyProfits(InputRecord inputRec, int expenseType) {
        for (int i = 0; i < MONTHS_IN_YEAR; i++) {
            double currentRevenue = inputRec.revenue[i]; // Corrected scope reference

            if (expenseType == EXPENSE_TYPE_STANDARD) {
                profit[i] = currentRevenue - expense.type[i];
                
            } else if (expenseType == EXPENSE_TYPE_CORPORATE) {
                profit[i] = currentRevenue - expense.type2[i]; // Fixed missing loop
                
            } else if (expenseType == EXPENSE_TYPE_SPECIAL) {
                profit[i] = currentRevenue - expense.type3[i]; // Fixed missing loop
            }
        }
    }
}